; Baseline for editors that do not run Biome. Biome reads this file too
; (formatter.useEditorconfig), so the two cannot drift apart.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 88

[*.md]
trim_trailing_whitespace = false

[*.{json,jsonc}]
indent_size = 2
