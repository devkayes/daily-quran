WXT_API_BASE_URL=https://pro.proggamoyquran.com
WXT_DAILY_AYAT_PATH=/api/v1/filter/daily-ayat
# Surah recitations: {base}/{bitrate}/{reciter}/{1-114}.mp3
# The surah-level CDN offers bitrates 96 and 128 only (32/40/48/64/192 are
# ayah-level). Reciter ids come from:
#   https://cdn.islamic.network/quran/info/by-surah/info.json
WXT_AUDIO_BASE_URL=https://cdn.islamic.network/quran/audio-surah
WXT_AUDIO_BITRATE=128
WXT_AUDIO_RECITER=ar.alafasy
WXT_SURAH_DETAILS_URL=https://app.proggamoyquran.com/surahDetails
WXT_ABOUT_URL=https://www.kayes.dev/talks/daily-quran
